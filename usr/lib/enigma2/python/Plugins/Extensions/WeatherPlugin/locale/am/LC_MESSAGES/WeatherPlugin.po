msgid "Add"
msgstr "አክል"

msgid "Back"
msgstr "ተመለስ"

msgid "Cancel"
msgstr "ሰርዝ"

msgid "City"
msgstr "ከተማ"

msgid "Delete"
msgstr "ሰርዝ"

msgid "Edit"
msgstr "አርትዕ"

msgid "Feels like %s"
msgstr "%s ይመስላል"

msgid "Getting weather information..."
msgstr "የአየር ሁኔታ መረጃን በማግኘት ላይ..."

msgid "Humidity: %s %%"
msgstr "እርጥበት፡ %s %%"

msgid "Location code"
msgstr "የአካባቢ ኮድ"

msgid "MSN location search result"
msgstr "የ MSN አካባቢ ፍለጋ ውጤት"

msgid "OK"
msgstr "እሺ"

msgid "Observation point: %s"
msgstr "የመመልከቻ ነጥብ፡ %s"

msgid "Observation time: %s"
msgstr "የምልከታ ጊዜ፡ %s"

msgid "Please enter a valid city name."
msgstr "እባክዎ የሚሰራ የከተማ ስም ያስገቡ።"

msgid "Please enter a valid location code for the city."
msgstr "እባክዎ ለከተማው የሚሰራ የአካባቢ ኮድ ያስገቡ።"

msgid "Really delete this WeatherPlugin Entry?"
msgstr "ይህ የአየር ሁኔታ ፕለጊን ግቤት በእርግጥ ይሰረዝ?"

msgid "Search Code"
msgstr "የፍለጋ ኮድ"

msgid "Show Weather Forecast"
msgstr "የአየር ሁኔታ ትንበያን አሳይ"

msgid "System"
msgstr "ስርዓት"

msgid "Weather Plugin"
msgstr "የአየር ሁኔታ ፕለጊን።"

msgid "WeatherPlugin: Edit Entry"
msgstr "WeatherPlugin፡ ግቤትን ያርትዑ"

msgid "WeatherPlugin: List of Entries"
msgstr "WeatherPlugin፡ የመግቢያ ዝርዝር"

msgid "You need to enter a valid city name before you can search for the location code."
msgstr "የአካባቢ ኮዱን ከመፈለግዎ በፊት የሚሰራ የከተማ ስም ማስገባት ያስፈልግዎታል።"

msgid "imperial system"
msgstr "ኢምፔሪያል ስርዓት"

msgid "metric system"
msgstr "የሜትሪክ ስርዓት"
