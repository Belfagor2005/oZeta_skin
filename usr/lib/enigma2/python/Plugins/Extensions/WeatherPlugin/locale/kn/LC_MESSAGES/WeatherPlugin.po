msgid "Add"
msgstr "ಸೇರಿಸಿ"

msgid "Back"
msgstr "ಹಿಂದೆ"

msgid "Cancel"
msgstr "ರದ್ದುಮಾಡು"

msgid "City"
msgstr "ನಗರ"

msgid "Delete"
msgstr "ಅಳಿಸಿ"

msgid "Edit"
msgstr "ಸಂಪಾದಿಸು"

msgid "Feels like %s"
msgstr "%s ಅನಿಸುತ್ತದೆ"

msgid "Getting weather information..."
msgstr "ಹವಾಮಾನ ಮಾಹಿತಿಯನ್ನು ಪಡೆಯಲಾಗುತ್ತಿದೆ..."

msgid "Humidity: %s %%"
msgstr "ಆರ್ದ್ರತೆ: %s %%"

msgid "Location code"
msgstr "ಸ್ಥಳ ಕೋಡ್"

msgid "MSN location search result"
msgstr "MSN ಸ್ಥಳ ಹುಡುಕಾಟ ಫಲಿತಾಂಶ"

msgid "OK"
msgstr "ಸರಿ"

msgid "Observation point: %s"
msgstr "ವೀಕ್ಷಣಾ ಬಿಂದು: %s"

msgid "Observation time: %s"
msgstr "ವೀಕ್ಷಣೆ ಸಮಯ: %s"

msgid "Please enter a valid city name."
msgstr "ದಯವಿಟ್ಟು ಮಾನ್ಯವಾದ ನಗರದ ಹೆಸರನ್ನು ನಮೂದಿಸಿ."

msgid "Please enter a valid location code for the city."
msgstr "ದಯವಿಟ್ಟು ನಗರಕ್ಕಾಗಿ ಮಾನ್ಯವಾದ ಸ್ಥಳ ಕೋಡ್ ಅನ್ನು ನಮೂದಿಸಿ."

msgid "Really delete this WeatherPlugin Entry?"
msgstr "ಈ WeatherPlugin ನಮೂದನ್ನು ನಿಜವಾಗಿಯೂ ಅಳಿಸುವುದೇ?"

msgid "Search Code"
msgstr "ಹುಡುಕಾಟ ಕೋಡ್"

msgid "Show Weather Forecast"
msgstr "ಹವಾಮಾನ ಮುನ್ಸೂಚನೆಯನ್ನು ತೋರಿಸಿ"

msgid "System"
msgstr "ವ್ಯವಸ್ಥೆ"

msgid "Weather Plugin"
msgstr "ಹವಾಮಾನ ಪ್ಲಗಿನ್"

msgid "WeatherPlugin: Edit Entry"
msgstr "WeatherPlugin: ಎಡಿಟ್ ಎಂಟ್ರಿ"

msgid "WeatherPlugin: List of Entries"
msgstr "WeatherPlugin: ನಮೂದುಗಳ ಪಟ್ಟಿ"

msgid "You need to enter a valid city name before you can search for the location code."
msgstr "ನೀವು ಸ್ಥಳ ಕೋಡ್ ಅನ್ನು ಹುಡುಕುವ ಮೊದಲು ನೀವು ಮಾನ್ಯವಾದ ನಗರದ ಹೆಸರನ್ನು ನಮೂದಿಸಬೇಕು."

msgid "imperial system"
msgstr "ಸಾಮ್ರಾಜ್ಯಶಾಹಿ ವ್ಯವಸ್ಥೆ"

msgid "metric system"
msgstr "ಮೆಟ್ರಿಕ್ ವ್ಯವಸ್ಥೆ"
