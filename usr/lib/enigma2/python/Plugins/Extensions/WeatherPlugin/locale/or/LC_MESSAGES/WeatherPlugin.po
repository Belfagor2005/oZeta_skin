msgstr "ବାତିଲ୍ କରନ୍ତୁ |"

msgid "City"
msgstr "ସହର"

msgid "Delete"
msgstr "ବିଲୋପ କରନ୍ତୁ |"

msgid "Edit"
msgstr "ସଂପାଦନା କରନ୍ତୁ |"

msgid "Feels like %s"
msgstr "% S ପରି ଅନୁଭବ କରେ |"

msgid "Getting weather information..."
msgstr "ପାଣିପାଗ ସୂଚନା ପାଇବା ..."

msgid "Humidity: %s %%"
msgstr "ଆର୍ଦ୍ରତା:% s %%"

