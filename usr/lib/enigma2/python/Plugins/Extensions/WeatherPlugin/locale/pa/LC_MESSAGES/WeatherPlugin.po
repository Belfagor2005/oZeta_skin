msgstr "%s ਵਰਗਾ ਮਹਿਸੂਸ ਹੁੰਦਾ ਹੈ"

msgid "Getting weather information..."
msgstr "ਮੌਸਮ ਦੀ ਜਾਣਕਾਰੀ ਪ੍ਰਾਪਤ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ..."

msgid "Humidity: %s %%"
msgstr "ਨਮੀ: %s %%"

msgid "Location code"
msgstr "ਟਿਕਾਣਾ ਕੋਡ"

msgid "MSN location search result"
msgstr "MSN ਟਿਕਾਣਾ ਖੋਜ ਨਤੀਜਾ"

msgid "OK"
msgstr "ਠੀਕ ਹੈ"

msgid "Observation point: %s"
msgstr "ਨਿਰੀਖਣ ਬਿੰਦੂ: %s"

msgid "Observation time: %s"
msgstr "ਨਿਰੀਖਣ ਦਾ ਸਮਾਂ: %s"

msgid "Please enter a valid city name."
msgstr "ਕਿਰਪਾ ਕਰਕੇ ਇੱਕ ਵੈਧ ਸ਼ਹਿਰ ਦਾ ਨਾਮ ਦਾਖਲ ਕਰੋ।"

