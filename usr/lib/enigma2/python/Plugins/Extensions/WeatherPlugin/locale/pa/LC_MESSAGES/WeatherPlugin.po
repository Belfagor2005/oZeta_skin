msgstr "ਕਿਰਪਾ ਕਰਕੇ ਸ਼ਹਿਰ ਲਈ ਇੱਕ ਵੈਧ ਟਿਕਾਣਾ ਕੋਡ ਦਾਖਲ ਕਰੋ।"

msgid "Really delete this WeatherPlugin Entry?"
msgstr "ਕੀ ਅਸਲ ਵਿੱਚ ਇਸ WeatherPlugin ਐਂਟਰੀ ਨੂੰ ਮਿਟਾਉਣਾ ਹੈ?"

msgid "Search Code"
msgstr "ਖੋਜ ਕੋਡ"

msgid "Show Weather Forecast"
msgstr "ਮੌਸਮ ਦੀ ਭਵਿੱਖਬਾਣੀ ਦਿਖਾਓ"

msgid "System"
msgstr "ਸਿਸਟਮ"

msgid "Weather Plugin"
msgstr "ਮੌਸਮ ਪਲੱਗਇਨ"

