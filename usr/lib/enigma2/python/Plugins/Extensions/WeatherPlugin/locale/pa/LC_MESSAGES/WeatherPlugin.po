msgid "Add"
msgstr "ਸ਼ਾਮਲ ਕਰੋ"

msgid "Back"
msgstr "ਵਾਪਸ"

msgid "Cancel"
msgstr "ਰੱਦ ਕਰੋ"

msgid "City"
msgstr "ਸ਼ਹਿਰ"

msgid "Delete"
msgstr "ਮਿਟਾਓ"

